{
	"name": "cv-tailor",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web",
		"deploy:setup": "vercel link",
		"dev:vercel": "vercel dev -L",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"deploy:check": "vercel deploy --dry",
		"desktop:setup-signing": "tsx scripts/setup-desktop-signing.ts",
		"desktop:release": "tsx scripts/release-desktop-macos.ts",
		"desktop:release:windows": "tsx scripts/release-desktop-windows.ts",
		"desktop:windows:setup": "node scripts/desktop-windows.mjs setup",
		"desktop:windows:setup-ssh": "node scripts/desktop-windows.mjs setup-ssh",
		"desktop:windows:connect": "node scripts/desktop-windows.mjs connect",
		"desktop:windows:build": "node scripts/desktop-windows.mjs build",
		"desktop:windows:release": "node scripts/desktop-windows.mjs release",
		"desktop:windows:remote:release": "tsx scripts/release-desktop-windows.ts",
		"desktop:icon": "node scripts/generate-app-icon.mjs && node scripts/generate-dmg-background.mjs && pnpm -F web tauri icon src-tauri/app-icon.png -o src-tauri/icons",
		"check": "biome check --write .",
		"clean:install": "node scripts/clean-install-dispatch.mjs",
		"test": "vitest run"
	},
	"dependencies": {
		"@cv-tailor/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@cv-tailor/config": "workspace:*",
		"@types/node": "catalog:",
		"sharp": "^0.34.5",
		"tsx": "^4.22.5",
		"turbo": "^2.10.2",
		"typescript": "catalog:",
		"vitest": "^4.0.15",
		"vercel": "^54.18.6"
	},
	"packageManager": "pnpm@10.15.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@journeyapps/wa-sqlite",
			"esbuild",
			"sharp"
		]
	}
}
