{
	"name": "cv-tailor",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web",
		"deploy:setup": "vercel link",
		"dev:vercel": "vercel dev -L",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"deploy:check": "vercel deploy --dry",
		"desktop:setup-signing": "tsx scripts/setup-desktop-signing.ts",
		"desktop:release": "tsx scripts/release-desktop-macos.ts",
		"check": "biome check --write .",
		"test": "vitest run"
	},
	"dependencies": {
		"@cv-tailor/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@cv-tailor/config": "workspace:*",
		"@types/node": "catalog:",
		"tsx": "^4.22.5",
		"turbo": "^2.10.2",
		"typescript": "catalog:",
		"vitest": "^4.0.15",
		"vercel": "^54.18.6"
	},
	"packageManager": "pnpm@10.15.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@journeyapps/wa-sqlite",
			"esbuild",
			"sharp"
		]
	}
}
