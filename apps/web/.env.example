VITE_SERVER_URL=http://localhost:3000
# Desktop local HTTP bridge (not the gateway). Gateway stays on :3911.
VITE_LOCAL_API_URL=http://127.0.0.1:3912

# MinIO / S3 — server / desktop process env only (NOT baked into the web bundle).
# Gateway reads these at runtime from apps/web/.env via dotenv.
# Desktop prefills Settings via a Tauri command that reads process env.
# Prefer CV_TAILOR_CLOUD_BACKUP_* in production; VITE_* names are accepted as fallback.
CV_TAILOR_CLOUD_BACKUP_ENDPOINT=http://192.168.188.50:9000
CV_TAILOR_CLOUD_BACKUP_BUCKET=cv-tailor-backups
CV_TAILOR_CLOUD_BACKUP_REGION=us-east-1
CV_TAILOR_CLOUD_BACKUP_ACCESS_KEY_ID=
CV_TAILOR_CLOUD_BACKUP_SECRET_ACCESS_KEY=
CV_TAILOR_CLOUD_BACKUP_PREFIX=cv-tailor/

# Optional aliases (same values; used if CV_TAILOR_* unset):
# VITE_CLOUD_BACKUP_ENDPOINT=
# VITE_CLOUD_BACKUP_BUCKET=
# VITE_CLOUD_BACKUP_REGION=
# VITE_CLOUD_BACKUP_ACCESS_KEY_ID=
# VITE_CLOUD_BACKUP_SECRET_ACCESS_KEY=
# VITE_CLOUD_BACKUP_PREFIX=

# Headless gateway
# Browser UI (same-origin) uses an HttpOnly cookie — do NOT put the token in VITE_*.
CV_TAILOR_GATEWAY_TOKEN=
# Optional alias loaded by the gateway process only:
# VITE_AI_GATEWAY_TOKEN=

# Optional when the web app talks to a remote gateway (not same-origin). Prefer VPN host.
# Use 127.0.0.1 / a real IP / Tailscale name — never http://0.0.0.0:3911 in the browser.
VITE_AI_GATEWAY_URL=http://127.0.0.1:3911
# When the gateway serves the built web UI, build with SAME_ORIGIN=true (see gateway:ui:build).
# VITE_AI_GATEWAY_SAME_ORIGIN=true
