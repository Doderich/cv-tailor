{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CV Tailor",
  "mainBinaryName": "CV Tailor",
  "version": "0.1.5",
  "identifier": "com.cvtailor.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CV Tailor",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "backgroundColor": "#101014"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": [
          "ipc:",
          "http://ipc.localhost",
          "https://github.com",
          "https://*.github.com",
          "https://*.githubusercontent.com"
        ],
        "font-src": [
          "'self'",
          "https://fonts.gstatic.com"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:",
          "data:"
        ],
        "style-src": [
          "'unsafe-inline'",
          "'self'",
          "https://fonts.googleapis.com"
        ],
        "script-src": [
          "'self'",
          "'wasm-unsafe-eval'"
        ]
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": [
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:1420",
          "http://127.0.0.1:1420",
          "http://127.0.0.1:3911",
          "ws://localhost:1420",
          "ws://127.0.0.1:1420",
          "https://github.com",
          "https://*.github.com",
          "https://*.githubusercontent.com"
        ],
        "font-src": [
          "'self'",
          "https://fonts.gstatic.com"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:",
          "data:"
        ],
        "style-src": [
          "'unsafe-inline'",
          "'self'",
          "https://fonts.googleapis.com"
        ],
        "script-src": [
          "'self'",
          "'wasm-unsafe-eval'"
        ]
      },
      "headers": {
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:cv-tailor.db"
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/Doderich/cv-tailor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxODNGMjM2QkU1MTdERUEKUldUcWZWRytOdktEMFFiM0RpYU5KYkt6NE9BZGk5cVpxSE9Ya05HMHRzSnQvQ2F5Ym9SclhqZFIK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "copyright": "Copyright © 2026 Malte Budig",
    "shortDescription": "Tailor CVs to job applications locally",
    "longDescription": "CV Tailor helps you import your profile, analyze job postings, score profile fit, and generate tailored CVs per application. All data stays on your device in a local SQLite database.",
    "category": "Productivity",
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleName": "CV Tailor",
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
